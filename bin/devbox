#!/usr/bin/env python3
"""Manage the JVM build-tool devbox.
"""

import argparse
from dataclasses import dataclass
import hashlib
import json
import os
import posixpath
import re
import shlex
import shutil
import subprocess
import sys
import time


DEFAULT_IMAGE = "ghcr.io/alexandru/devbox:latest"
DEFAULT_AGENT_PORT = "10012"
DEFAULT_HOME_VOLUME = "devbox-home"
CONTAINER_NAME = "devbox"
CONTAINER_LABEL = "org.alexn.devbox=true"
HOME_VOLUME_LABEL = "org.alexn.devbox.home-volume"
MOUNTS_LABEL = "org.alexn.devbox.mounts"
NESTED_SANDBOX_LABEL = "org.alexn.devbox.nested-sandbox"
EXTRA_ARGS_LABEL = "org.alexn.devbox.extra-args"
CONTAINER_SOCKET_LABEL = "org.alexn.devbox.container-socket"
MODE_LABEL = "org.alexn.devbox.mode"
WORKSPACE_LABEL = "org.alexn.devbox.workspace"
SSH_PORT_LABEL = "org.alexn.devbox.ssh-port"
WORKSPACE_LINK = "/workspace"
CONTAINER_USER = "dev"
ROOT_USER = "root"

RESERVED_ENV_NAMES = frozenset(
    {
        "DEVBOX_IMAGE",
        "DEVBOX_AGENT_PORT",
        "DEVBOX_HOME_VOLUME",
        "DEVBOX_HOME_VOLUME_PREFIX",
        "DEVBOX_CONTAINER_SOCKET",
        "DEVBOX_WIREGUARD_CONFIG_PATH",
        "DEVBOX_WIREGUARD_CONFIG_STR",
        "DEVBOX_WIREGUARD_MTU",
    }
)
ENVIRONMENT_SUFFIX_PATTERN = re.compile(r"[A-Za-z_][A-Za-z0-9_]*\Z")


@dataclass(frozen=True)
class Mount:
    original: str
    source: str
    target: str
    options: str
    kind: str = "bind"

    def volume_spec(self):
        suffix = f":{self.options}" if self.options else ""
        return f"{self.source}:{self.target}{suffix}"

IMAGE = os.environ.get("DEVBOX_IMAGE") or DEFAULT_IMAGE
HOME_VOLUME_NAME = os.environ.get("DEVBOX_HOME_VOLUME") or DEFAULT_HOME_VOLUME
LEGACY_HOME_VOLUME_PREFIX = os.environ.get("DEVBOX_HOME_VOLUME_PREFIX") or f"{HOME_VOLUME_NAME}-"
WIREGUARD_CONFIG_CONTAINER_PATH = "/etc/wireguard/devbox.conf"

def canonical_dir(path, description):
    if not os.path.isdir(path):
        print(f"{description} directory does not exist: {path}", file=sys.stderr)
        raise SystemExit(1)
    return os.path.realpath(path)


def canonical_file(path, description):
    path = os.path.expanduser(path)
    if not os.path.isfile(path):
        print(f"{description} file does not exist: {path}", file=sys.stderr)
        raise SystemExit(1)
    return os.path.realpath(path)


def tcp_port(value):
    if not re.fullmatch(r"[0-9]+", value) or not 1 <= int(value) <= 65535:
        raise argparse.ArgumentTypeError("must be an integer from 1 through 65535")
    return value


def workspace_path(path):
    return canonical_dir(path, "Workspace")


def path_is_within(path, parent):
    try:
        return os.path.commonpath([path, parent]) == parent
    except ValueError:
        return False


def git_rev_parse_dir(workspace_dir, option):
    try:
        result = subprocess.run(
            ["git", "-C", workspace_dir, "rev-parse", "--path-format=absolute", option],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            check=False,
        )
    except FileNotFoundError:
        return ""

    if result.returncode != 0:
        return ""

    path = result.stdout.strip()
    if not path:
        return ""

    return os.path.realpath(path)


def workspace_mount_path(workspace_dir):
    paths = [workspace_dir]

    for option in ("--git-dir", "--git-common-dir"):
        path = git_rev_parse_dir(workspace_dir, option)
        if path:
            paths.append(path)

    return os.path.commonpath(paths)


def home_volume():
    return HOME_VOLUME_NAME


def is_wslc_cli(container_cli):
    return os.path.basename(container_cli).lower() in {"wslc", "wslc.exe"}


def normalize_container_path(path):
    if path.startswith("\\\\wsl.localhost\\") or path.startswith("\\\\wsl$\\"):
        parts = path.split("\\")
        if len(parts) > 4:
            return "/" + "/".join(parts[4:])
    if sys.platform == "darwin":
        if path == "/host_mnt":
            return "/"
        if path.startswith("/host_mnt/"):
            return path[len("/host_mnt"):]
    return path


def container_path(path):
    if len(path) >= 3 and path[0].isalpha() and path[1] == ":" and path[2] in {"\\", "/"}:
        suffix = path[2:].replace("\\", "/")
        return f"/{path[0].lower()}{suffix}"
    return path


def yaml_quote(value):
    return json.dumps(value)


def configured_container_envs():
    environment = []
    for source_name in sorted(os.environ):
        if not source_name.startswith("DEVBOX_") or source_name in RESERVED_ENV_NAMES:
            continue
        target = source_name.removeprefix("DEVBOX_")
        if not ENVIRONMENT_SUFFIX_PATTERN.fullmatch(target):
            raise SystemExit(
                f"Invalid environment variable name after DEVBOX_ prefix: {source_name}"
            )
        environment.append((source_name, target, os.environ[source_name]))
    return environment


def canonical_mount_source(path):
    if not os.path.exists(path):
        raise SystemExit(f"Mount source does not exist: {path}")
    return os.path.realpath(path)


def split_mount_specification(specification):
    separator_indexes = [index for index, character in enumerate(specification) if character == ":"]
    if (
        len(specification) >= 3
        and specification[0].isalpha()
        and specification[1] == ":"
        and specification[2] in {"\\", "/"}
    ):
        separator_indexes = separator_indexes[1:]
    if not separator_indexes:
        raise SystemExit(
            f"Invalid mount specification: {specification}. Expected HOST:CONTAINER[:OPTIONS]."
        )

    source_end = separator_indexes[0]
    source = specification[:source_end]
    remainder = specification[source_end + 1 :]
    target, separator, options = remainder.partition(":")
    if not source or not target:
        raise SystemExit(
            f"Invalid mount specification: {specification}. Expected HOST:CONTAINER[:OPTIONS]."
        )
    return source, target, options if separator else ""


def parse_mounts(specifications):
    mounts = []
    targets = set()
    for specification in specifications:
        source, target, options = split_mount_specification(specification)
        if not posixpath.isabs(target):
            raise SystemExit(f"Mount target must be an absolute container path: {target}")
        if target in targets:
            raise SystemExit(f"Duplicate mount target: {target}")
        targets.add(target)
        mounts.append(Mount(specification, canonical_mount_source(source), target, options))
    return mounts


VOLUME_NAME_PATTERN = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.-]*\Z")


def split_volume_specification(specification):
    parts = specification.split(":")
    if len(parts) > 3 or len(parts) < 2 or not parts[0] or not parts[1]:
        raise SystemExit(
            f"Invalid volume specification: {specification}. Expected NAME:CONTAINER[:OPTIONS]."
        )
    name, target = parts[:2]
    options = parts[2] if len(parts) == 3 else ""
    if len(parts) == 3 and not options:
        raise SystemExit(
            f"Invalid volume specification: {specification}. Expected NAME:CONTAINER[:OPTIONS]."
        )
    if not VOLUME_NAME_PATTERN.fullmatch(name):
        raise SystemExit(f"Invalid named volume name: {name}")
    if options not in {"", "ro", "rw"}:
        raise SystemExit(f"Invalid named volume options: {options}. Expected ro or rw.")
    return name, target, options


def expand_container_home(path):
    if path == "~":
        return "/home/dev"
    if path.startswith("~/"):
        return posixpath.normpath(posixpath.join("/home/dev", path[2:]))
    return path


def normalize_home_path(path):
    path = expand_container_home(path)
    if posixpath.isabs(path):
        return posixpath.normpath(path)
    raise SystemExit(f"Named volume target must be an absolute container path or ~/...: {path}")


def parse_named_volumes(specifications, mounts=()):
    volumes = []
    targets = {mount.target for mount in mounts}
    for specification in specifications:
        name, target, options = split_volume_specification(specification)
        target = normalize_home_path(target)
        if target == "/home/dev":
            raise SystemExit("Named volume target /home/dev conflicts with the managed home volume")
        if name == HOME_VOLUME_NAME or name.startswith(LEGACY_HOME_VOLUME_PREFIX):
            raise SystemExit(f"Named volume name is reserved for Devbox home cleanup: {name}")
        if target in targets:
            raise SystemExit(f"Duplicate mount target: {target}")
        targets.add(target)
        volumes.append(Mount(specification, name, target, options, "volume"))
    return volumes


def find_container_cli():
    configured = os.environ.get("CONTAINER_CLI")
    if configured:
        return configured

    for cli in ("wslc.exe", "wslc", "docker", "podman"):
        path = shutil.which(cli)
        if path:
            return path

    return None


def ordered_add(values, value):
    if value and value not in values:
        values.append(value)


class DevBox:
    def __init__(
        self,
        command,
        workspace_dir="",
        command_args=None,
        container_cli=None,
        execution_dir="",
    ):
        self.command = command
        self.workspace_dir = workspace_dir
        self.workspace_mount_dir = workspace_mount_path(workspace_dir) if workspace_dir else ""
        self.workspace_container_dir = container_path(workspace_dir)
        self.workspace_container_mount_dir = container_path(self.workspace_mount_dir)
        self.mode = "workspace" if workspace_dir else ("container-native" if command in {"start", "compose"} else "")
        self.command_args = list(command_args or [])
        self.execution_dir = execution_dir
        self.container_cli = container_cli or ""
        self.container_name = CONTAINER_NAME
        self.home_volume = home_volume()
        self.mounts = []
        self.named_volumes = []
        self.agent_port = ""
        self.container_env_args = []
        self.wireguard_config_host_path = ""
        self.wireguard_config_str = ""
        self.wireguard_mtu = ""
        self.nested_sandbox = False
        self.extra_args = []
        self.container_socket_request = ""
        self.container_socket = ""
        self.container_socket_gid = None
        self.rootless_podman_socket = False
        self.ssh_port = ""

    def uses_wslc(self):
        return is_wslc_cli(self.container_cli)

    def uses_podman(self):
        return os.path.basename(self.container_cli).lower() in {"podman", "podman.exe"}

    def inspect_args(self):
        if self.uses_podman():
            return ["container", "inspect"]
        return ["inspect"]

    def run_cli(self, args, *, stdout=None, stderr=None, capture=False, check=False):
        command = [self.container_cli, *args]
        if capture:
            result = subprocess.run(
                command,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL if stderr is None else stderr,
                text=True,
                check=False,
            )
        else:
            result = subprocess.run(command, stdout=stdout, stderr=stderr, check=False)

        if check and result.returncode != 0:
            raise SystemExit(result.returncode)
        return result

    def inspect_objects(self, *names):
        result = self.run_cli([*self.inspect_args(), *names], capture=True)
        if result.returncode != 0 or not result.stdout.strip():
            return []

        try:
            payload = json.loads(result.stdout)
        except json.JSONDecodeError:
            return []

        if isinstance(payload, list):
            return payload
        if isinstance(payload, dict):
            return [payload]
        return []

    def inspect_object(self, name):
        objects = self.inspect_objects(name)
        return objects[0] if objects else {}

    def configure_wireguard(self):
        config_path = os.environ.get("DEVBOX_WIREGUARD_CONFIG_PATH", "")
        config_str = os.environ.get("DEVBOX_WIREGUARD_CONFIG_STR", "")
        if config_path and config_str:
            raise SystemExit(
                "Set only one of DEVBOX_WIREGUARD_CONFIG_PATH and DEVBOX_WIREGUARD_CONFIG_STR."
            )
        if config_path or config_str:
            if self.uses_wslc():
                raise SystemExit(
                    "WireGuard is not supported by wslc because wslc cannot grant the required "
                    "NET_ADMIN capability. Set CONTAINER_CLI=podman or CONTAINER_CLI=docker."
                )
            if config_path:
                self.wireguard_config_host_path = canonical_file(config_path, "WireGuard config")
            else:
                self.wireguard_config_str = config_str
            self.wireguard_mtu = os.environ.get("DEVBOX_WIREGUARD_MTU", "1420")
            if not self.wireguard_mtu.isdigit() or not 576 <= int(self.wireguard_mtu) <= 9000:
                raise SystemExit("DEVBOX_WIREGUARD_MTU must be an integer from 576 through 9000.")

    def configure_nested_sandbox(self):
        if self.nested_sandbox and self.uses_wslc():
            raise SystemExit(
                "Nested sandbox is not supported by wslc. Set CONTAINER_CLI=podman or CONTAINER_CLI=docker."
            )

    def configure_container_socket(self):
        if not self.container_socket_request:
            return
        if self.uses_wslc():
            raise SystemExit(
                "Container socket access is not supported by wslc. "
                "Set CONTAINER_CLI=podman or CONTAINER_CLI=docker."
            )

        requested = self.container_socket_request
        if requested == "auto":
            requested = os.environ.get("DEVBOX_CONTAINER_SOCKET", "")
        if not requested:
            docker_host = os.environ.get("DOCKER_HOST", "")
            if docker_host.startswith("unix://"):
                requested = docker_host.removeprefix("unix://")

        candidates = []
        if requested:
            candidates.append(os.path.expanduser(requested))
        elif self.uses_podman():
            runtime_dir = os.environ.get("XDG_RUNTIME_DIR", "")
            if runtime_dir:
                candidates.append(os.path.join(runtime_dir, "podman", "podman.sock"))
            candidates.extend(
                [
                    f"/run/user/{os.getuid()}/podman/podman.sock",
                    "/run/podman/podman.sock",
                ]
            )
        else:
            candidates.extend(
                [
                    "/var/run/docker.sock",
                    os.path.expanduser("~/.docker/run/docker.sock"),
                ]
            )

        source = next((path for path in candidates if os.path.exists(path)), "")
        if not source:
            checked = ", ".join(candidates) or "no default paths"
            raise SystemExit(
                f"Container socket not found ({checked}). "
                "Pass --container-socket HOST_PATH or set DEVBOX_CONTAINER_SOCKET."
            )

        self.container_socket = os.path.realpath(source)
        self.container_socket_gid = os.stat(self.container_socket).st_gid
        self.rootless_podman_socket = self.uses_podman() and self.container_socket.startswith("/run/user/")

    def container_socket_args(self):
        if not self.container_socket:
            return []
        args = [
            "-v",
            f"{self.container_socket}:/var/run/docker.sock",
            "--group-add",
            str(self.container_socket_gid),
            "-e",
            "DOCKER_HOST=unix:///var/run/docker.sock",
            "-e",
            "TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock",
        ]
        if self.rootless_podman_socket:
            args.extend(["-e", "TESTCONTAINERS_RYUK_DISABLED=true"])
        if self.uses_podman():
            args.extend(["--security-opt", "label=disable"])
        return args

    def wireguard_enabled(self):
        return bool(self.wireguard_config_host_path or self.wireguard_config_str)

    def configure_container_env_args(self):
        self.container_env_args = []

        for _, target, value in configured_container_envs():
            self.container_env_args.extend(["-e", f"{target}={value}"])

    def configure_agent_port(self):
        self.agent_port = os.environ.get("DEVBOX_AGENT_PORT", "")
        if self.command in {"start", "compose"} and not self.agent_port:
            self.agent_port = DEFAULT_AGENT_PORT
        if self.ssh_port and self.ssh_port == self.agent_port:
            raise SystemExit("SSH host port must differ from the agent host port.")

    def container_inspect(self):
        return self.inspect_object(self.container_name)

    def container_exists(self):
        return bool(self.container_inspect())

    def container_running_state(self, container):
        state = container.get("State", {}) if container else {}
        return isinstance(state, dict) and bool(state.get("Running"))

    def assert_container_running(self):
        container = self.container_inspect()
        if self.container_running_state(container):
            return
        if container:
            print(f"Container is not running: {self.container_name}", file=sys.stderr)
            print(
                f"Run `{sys.argv[0]} start [--workspace HOST_DIR]` to start it.",
                file=sys.stderr,
            )
        else:
            print(f"Container does not exist: {self.container_name}", file=sys.stderr)
            print(
                f"Run `{sys.argv[0]} start [--workspace HOST_DIR]` to create it.",
                file=sys.stderr,
            )
        raise SystemExit(1)

    def container_mount_source(self, destination):
        container = self.inspect_object(self.container_name)
        for mount in container.get("Mounts", []):
            if mount.get("Destination") == destination:
                return normalize_container_path(mount.get("Source", ""))
        return ""

    def workspace_mount(self, container):
        workdir = container.get("Config", {}).get("WorkingDir", "")
        if not workdir:
            return "", ""

        candidates = []
        for mount in container.get("Mounts", []):
            if mount.get("Type", "bind") != "bind":
                continue
            if not mount.get("Type") and mount.get("Name"):
                continue
            source = normalize_container_path(mount.get("Source", ""))
            destination = mount.get("Destination", "")
            if destination == "/home/dev":
                continue
            if not source or not destination:
                continue
            if not posixpath.commonpath([workdir, destination]) == destination:
                continue
            candidates.append((destination, source))

        if not candidates:
            return "", ""

        destination, source = min(candidates, key=lambda mount: len(mount[0]))
        return os.path.realpath(source), destination

    def container_workspace_mount(self):
        mount = self.workspace_mount(self.container_inspect())
        if not all(mount):
            print("Container does not have a workspace bind mount.", file=sys.stderr)
            raise SystemExit(1)
        return mount

    def container_mode(self, container=None):
        container = container or self.container_inspect()
        labels = container.get("Config", {}).get("Labels", {}) or {}
        mode = labels.get(MODE_LABEL, "")
        if mode in {"workspace", "container-native"}:
            return mode
        if container.get("Config", {}).get("WorkingDir", "") == "/home/dev":
            return "container-native"
        return "workspace" if self.workspace_mount(container)[0] else "container-native"

    def native_container_directory(self, path):
        path = expand_container_home(path)
        if posixpath.isabs(path):
            return posixpath.normpath(path)
        return posixpath.normpath(posixpath.join("/home/dev", path))

    def container_directory(self, host_directory):
        if self.mode == "container-native" or (
            not self.mode and self.container_mode() == "container-native"
        ):
            return self.native_container_directory(host_directory)
        requested_dir = canonical_dir(host_directory, "Requested")
        host_mount_dir, container_mount_dir = self.container_workspace_mount()

        if not path_is_within(requested_dir, host_mount_dir):
            print(
                f"Requested directory is outside the started workspace: {requested_dir}",
                file=sys.stderr,
            )
            raise SystemExit(1)

        relative_path = os.path.relpath(requested_dir, host_mount_dir)
        if relative_path == ".":
            return container_mount_dir
        if os.name == "nt":
            relative_path = relative_path.replace("\\", "/")
        return posixpath.normpath(posixpath.join(container_mount_dir, relative_path))

    def container_agent_ports(self, container=None):
        container = container or self.inspect_object(self.container_name)
        bindings = container.get("HostConfig", {}).get("PortBindings", {}).get("10012/tcp") or []
        if not bindings:
            bindings = container.get("Ports", {}).get("10012/tcp") or []
        return [binding.get("HostPort", "") for binding in bindings if binding.get("HostPort")]

    def mount_label(self):
        metadata = []
        for mount in [*self.mounts, *self.named_volumes]:
            item = {"source": mount.source, "target": mount.target, "options": mount.options}
            if mount.kind != "bind":
                item["type"] = mount.kind
            metadata.append(item)
        return json.dumps(
            sorted(metadata, key=lambda mount: (mount["target"], mount["source"], mount["options"])),
            separators=(",", ":"),
        )

    def ensure_custom_mounts(self):
        labels = self.container_inspect().get("Config", {}).get("Labels", {}) or {}
        current = labels.get(MOUNTS_LABEL, "[]")
        if current == self.mount_label():
            return
        print("Container already exists with different custom mounts.", file=sys.stderr)
        print(
            f"Run `{sys.argv[0]} purge` and start it again to apply the requested mounts.",
            file=sys.stderr,
        )
        raise SystemExit(1)

    def ensure_nested_sandbox(self):
        labels = self.container_inspect().get("Config", {}).get("Labels", {}) or {}
        current = labels.get(NESTED_SANDBOX_LABEL, "false") == "true"
        if current == self.nested_sandbox:
            return

        print("Container already exists with different nested sandbox configuration.", file=sys.stderr)
        print(
            f"Run `{sys.argv[0]} purge` and start it again to apply --nested-sandbox.",
            file=sys.stderr,
        )
        raise SystemExit(1)

    def extra_args_label(self):
        return json.dumps(self.extra_args, separators=(",", ":"))

    def ensure_extra_args(self):
        labels = self.container_inspect().get("Config", {}).get("Labels", {}) or {}
        current = labels.get(EXTRA_ARGS_LABEL, "[]")
        if current == self.extra_args_label():
            return

        print("Container already exists with different extra docker run arguments.", file=sys.stderr)
        print(
            f"Run `{sys.argv[0]} purge` and start it again to apply --extra-args.",
            file=sys.stderr,
        )
        raise SystemExit(1)

    def ensure_container_socket(self):
        labels = self.container_inspect().get("Config", {}).get("Labels", {}) or {}
        if labels.get(CONTAINER_SOCKET_LABEL, "") == self.container_socket:
            return
        print("Container already exists with different container socket access.", file=sys.stderr)
        print(
            f"Run `{sys.argv[0]} purge` and start it again to apply --container-socket.",
            file=sys.stderr,
        )
        raise SystemExit(1)

    def ensure_wireguard_config(self):
        mounted_path = self.container_mount_source(WIREGUARD_CONFIG_CONTAINER_PATH)
        container = self.container_inspect()
        config_str = next(
            (
                value.split("=", 1)[1]
                for value in container.get("Config", {}).get("Env", [])
                if value.startswith("DEVBOX_WIREGUARD_CONFIG_STR=")
            ),
            "",
        )
        if mounted_path == self.wireguard_config_host_path and config_str == self.wireguard_config_str:
            return

        print("Container already exists with different WireGuard configuration.", file=sys.stderr)
        print(
            f"Run `{sys.argv[0]} purge` and start it again to apply the WireGuard configuration.",
            file=sys.stderr,
        )
        raise SystemExit(1)

    def ensure_agent_port(self):
        if not self.agent_port:
            return

        if self.agent_port in self.container_agent_ports():
            return

        print(
            f"Container already exists without host port {self.agent_port} mapped to container port 10012.",
            file=sys.stderr,
        )
        print(
            f"Run `{sys.argv[0]} purge` and start it again to apply DEVBOX_AGENT_PORT.",
            file=sys.stderr,
        )
        raise SystemExit(1)

    def ensure_ssh_port(self):
        labels = self.container_inspect().get("Config", {}).get("Labels", {}) or {}
        if labels.get(SSH_PORT_LABEL, "") == self.ssh_port:
            return

        print("Container already exists with a different SSH port.", file=sys.stderr)
        print(
            f"Run `{sys.argv[0]} purge` and start it again to apply --ssh-port.",
            file=sys.stderr,
        )
        raise SystemExit(1)

    def ensure_workspace_configuration(self):
        container = self.container_inspect()
        running_mode = self.container_mode(container)
        running_labels = container.get("Config", {}).get("Labels", {}) or {}
        if running_mode == "workspace":
            running_mount_source, running_mount_destination = self.workspace_mount(container)
        else:
            running_mount_source, running_mount_destination = "", ""
        running_workdir = container.get("Config", {}).get("WorkingDir", "")
        current_mount = (self.workspace_mount_dir, self.workspace_container_mount_dir)

        if (
            self.mode == running_mode == "container-native"
            and not running_mount_source
            and running_workdir == "/home/dev"
        ):
            return
        if (
            self.mode == running_mode == "workspace"
            and (running_mount_source, running_mount_destination) == current_mount
            and running_workdir == self.workspace_container_dir
            and running_labels.get(WORKSPACE_LABEL, self.workspace_dir) == self.workspace_dir
        ):
            return

        print("Container already exists with different workspace configuration.", file=sys.stderr)
        print("Running container configuration:", file=sys.stderr)
        print(f"  Mode: {running_mode}", file=sys.stderr)
        if running_mount_source and running_mount_destination:
            print(f"  Workspace: {running_mount_source} -> {running_mount_destination}", file=sys.stderr)
        else:
            print("  Workspace: not mounted", file=sys.stderr)
        print(f"  Workdir: {running_workdir or 'not set'}", file=sys.stderr)
        print("Current configuration:", file=sys.stderr)
        print(f"  Mode: {self.mode}", file=sys.stderr)
        if self.mode == "workspace":
            print(f"  Workspace: {self.workspace_mount_dir} -> {self.workspace_container_mount_dir}", file=sys.stderr)
        else:
            print("  Workspace: not mounted", file=sys.stderr)
        print(f"  Workdir: {self.effective_workdir()}", file=sys.stderr)
        print(
            f"Run `{sys.argv[0]} purge` and start it again to apply the current workspace configuration.",
            file=sys.stderr,
        )
        raise SystemExit(1)

    def start_container(self, *, announce=True):
        if self.wireguard_enabled():
            source = self.wireguard_config_host_path or "DEVBOX_WIREGUARD_CONFIG_STR"
            print(f"WireGuard: enabled ({source})")
            print(f"WireGuard: attempting connection with MTU {self.wireguard_mtu}...")

        if self.container_exists():
            self.ensure_workspace_configuration()
            self.ensure_custom_mounts()
            self.ensure_nested_sandbox()
            self.ensure_extra_args()
            self.ensure_container_socket()
            self.ensure_wireguard_config()
            self.ensure_agent_port()
            self.ensure_ssh_port()
            self.run_cli(
                ["start", self.container_name],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        else:
            self.create_home_volume()
            self.run_new_container()

        self.ensure_container_started()

        if self.wireguard_enabled():
            print("WireGuard: tunnel interface started.")

        if announce:
            self.print_start_summary()

    def effective_workdir(self):
        return self.workspace_container_dir if self.mode == "workspace" else "/home/dev"

    def container_logs(self):
        result = self.run_cli(["logs", self.container_name], capture=True, stderr=subprocess.STDOUT)
        return result.stdout.strip() if result.returncode == 0 else ""

    def ensure_container_started(self):
        container = self.container_inspect()
        if self.container_running_state(container):
            return

        state = container.get("State", {}) if container else {}
        exit_code = state.get("ExitCode")
        if exit_code is None:
            print(f"Container failed to start: {self.container_name}", file=sys.stderr)
        else:
            print(f"Container exited with status {exit_code}: {self.container_name}", file=sys.stderr)

        error = state.get("Error", "")
        if error:
            print(error, file=sys.stderr)
        logs = self.container_logs()
        if logs:
            print("Container logs:", file=sys.stderr)
            print(logs, file=sys.stderr)
        raise SystemExit(1)

    def create_home_volume(self):
        self.run_cli(
            [
                "volume",
                "create",
                "--label",
                CONTAINER_LABEL,
                "--label",
                f"{HOME_VOLUME_LABEL}={self.home_volume}",
                self.home_volume,
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )

    def custom_mount_args(self):
        arguments = []
        for mount in [*self.mounts, *self.named_volumes]:
            arguments.extend(["-v", mount.volume_spec()])
        return arguments

    def custom_volume_initialization(self):
        commands = []
        for volume in self.named_volumes:
            if volume.options == "ro":
                continue
            target = shlex.quote(volume.target)
            commands.append(
                f"if [ -z \"$(find {target} -mindepth 1 -maxdepth 1 -print -quit)\" ]; "
                f"then chown dev:dev {target}; fi"
            )
        return " && ".join(commands)

    def agent_port_args(self):
        if not self.agent_port:
            return []

        return ["-p", f"{self.agent_port}:10012"]

    def ssh_port_args(self):
        if not self.ssh_port:
            return []

        return ["-p", f"127.0.0.1:{self.ssh_port}:22"]

    def container_wireguard_status(self):
        result = self.run_cli(
            ["exec", "-u", ROOT_USER, self.container_name, "wg", "show", "devbox", "latest-handshakes"],
            capture=True,
        )
        if result.returncode != 0:
            return "interface unavailable"

        handshakes = []
        for line in result.stdout.splitlines():
            fields = line.split()
            if len(fields) >= 2 and fields[-1].isdigit():
                handshakes.append(int(fields[-1]))
        latest = max(handshakes, default=0)
        if latest <= 0:
            return "active; no handshake yet"

        age = max(0, int(time.time()) - latest)
        return f"active; latest handshake {age} seconds ago"

    def status_container(self):
        print(f"Runtime:   {os.path.basename(self.container_cli)}")
        print(f"Container: {self.container_name}")
        container = self.container_inspect()
        if not container:
            print("Status:    not created")
            return

        state = container.get("State", {})
        running = self.container_running_state(container)
        status = state.get("Status") or ("running" if running else "stopped")
        if not running and state.get("ExitCode") is not None:
            status += f" (exit code {state['ExitCode']})"
        print(f"Status:    {status}")

        config = container.get("Config", {})
        if config.get("Image"):
            print(f"Image:     {config['Image']}")
        if container.get("Id"):
            print(f"ID:        {container['Id'][:12]}")
        if container.get("Created"):
            print(f"Created:   {container['Created']}")
        if state.get("StartedAt"):
            print(f"Started:   {state['StartedAt']}")
        if not running and state.get("FinishedAt"):
            print(f"Finished:  {state['FinishedAt']}")
        mode = self.container_mode(container)
        print(f"Mode:      {mode}")
        if mode == "workspace":
            workspace_source, workspace_target = self.workspace_mount(container)
            print(f"Workspace: {workspace_source} -> {workspace_target}")
        if config.get("WorkingDir"):
            print(f"Workdir:   {config['WorkingDir']}")

        mounts = container.get("Mounts", [])
        if mounts:
            print("Mounts:")
            for mount in mounts:
                source = normalize_container_path(mount.get("Source", "")) or mount.get("Name", "")
                destination = mount.get("Destination", "")
                if source and destination:
                    mode = "rw" if mount.get("RW", True) else "ro"
                    print(f"  {source} -> {destination} ({mode})")

            custom_volumes = [
                mount
                for mount in mounts
                if mount.get("Destination") != "/home/dev"
                and (mount.get("Type") == "volume" or mount.get("Name"))
            ]
            if custom_volumes:
                print("Custom volumes:")
                for mount in custom_volumes:
                    source = mount.get("Name", "")
                    mode = "rw" if mount.get("RW", True) else "ro"
                    print(f"  {source} -> {mount.get('Destination', '')} ({mode})")

        ssh_port = (config.get("Labels", {}) or {}).get(SSH_PORT_LABEL, "")
        if ssh_port:
            print(f"SSH:       dev@localhost:{ssh_port}")
        else:
            print("SSH:       disabled")

        ports = self.container_agent_ports(container)
        if ports:
            print(f"Agent:     localhost:{ports[0]} -> 10012/tcp")
        else:
            print("Agent:     not published")

        wireguard_mount = next(
            (mount for mount in mounts if mount.get("Destination") == WIREGUARD_CONFIG_CONTAINER_PATH),
            None,
        )
        wireguard_config_str = any(
            value.startswith("DEVBOX_WIREGUARD_CONFIG_STR=") for value in config.get("Env", [])
        )
        if not wireguard_mount and not wireguard_config_str:
            print("WireGuard: disabled")
            return

        wireguard_source = (
            normalize_container_path(wireguard_mount.get("Source", ""))
            if wireguard_mount
            else "DEVBOX_WIREGUARD_CONFIG_STR"
        )
        mtu = next(
            (
                value.split("=", 1)[1]
                for value in config.get("Env", [])
                if value.startswith("DEVBOX_WIREGUARD_MTU=")
            ),
            "unknown",
        )
        print(f"WireGuard: enabled; config={wireguard_source}; MTU={mtu}")
        print(f"Tunnel:    {self.container_wireguard_status() if running else 'container not running'}")

    def wireguard_args(self):
        if not self.wireguard_enabled():
            return []

        args = [
            "--cap-add",
            "NET_ADMIN",
            "--sysctl",
            "net.ipv4.conf.all.src_valid_mark=1",
            "--add-host",
            "host.docker.internal:host-gateway",
        ]
        if self.wireguard_config_host_path:
            args.extend(["-v", f"{self.wireguard_config_host_path}:{WIREGUARD_CONFIG_CONTAINER_PATH}:ro"])
        else:
            args.extend(["-e", f"DEVBOX_WIREGUARD_CONFIG_STR={self.wireguard_config_str}"])
        args.extend(["-e", f"DEVBOX_WIREGUARD_MTU={self.wireguard_mtu}"])
        return args

    def nested_sandbox_args(self):
        if not self.nested_sandbox:
            return []
        args = []
        for capability in ("SYS_ADMIN", "SYS_CHROOT", "SETUID", "SETGID", "SYS_PTRACE"):
            args.extend(["--cap-add", capability])
        return [*args, "--security-opt", "seccomp=unconfined", "--security-opt", "apparmor=unconfined"]

    def wireguard_host_route_command(self):
        # wg-quick suppresses the main default route for a full tunnel. A specific
        # main-table route keeps Docker Desktop's host endpoint outside the tunnel.
        return (
            'HOST_DOCKER_INTERNAL_IP="$(getent ahostsv4 host.docker.internal | '
            "awk 'NR == 1 { print $1; exit }')\" && "
            'test -n "$HOST_DOCKER_INTERNAL_IP" && '
            'HOST_DOCKER_INTERNAL_ROUTE="$(ip -4 route get "$HOST_DOCKER_INTERNAL_IP")" && '
            'HOST_DOCKER_INTERNAL_GATEWAY="$(printf \'%s\\n\' "$HOST_DOCKER_INTERNAL_ROUTE" | '
            "awk '{ for (i = 1; i < NF; i++) if ($i == \"via\") { print $(i + 1); exit } }')\" && "
            'HOST_DOCKER_INTERNAL_DEVICE="$(printf \'%s\\n\' "$HOST_DOCKER_INTERNAL_ROUTE" | '
            "awk '{ for (i = 1; i < NF; i++) if ($i == \"dev\") { print $(i + 1); exit } }')\" && "
            'test -n "$HOST_DOCKER_INTERNAL_DEVICE" && '
            'if [ -n "$HOST_DOCKER_INTERNAL_GATEWAY" ]; then '
            'ip -4 route replace table main "$HOST_DOCKER_INTERNAL_IP/32" '
            'via "$HOST_DOCKER_INTERNAL_GATEWAY" dev "$HOST_DOCKER_INTERNAL_DEVICE"; '
            'else ip -4 route replace table main "$HOST_DOCKER_INTERNAL_IP/32" '
            'dev "$HOST_DOCKER_INTERNAL_DEVICE"; fi'
        )

    def workspace_link_command(self):
        initialization = self.custom_volume_initialization()
        keepalive = "exec sleep infinity"
        if self.ssh_port:
            keepalive = f"devbox-start-sshd && {keepalive}"
        if self.mode == "workspace":
            command = (
                f"rm -rf {WORKSPACE_LINK} && "
                f"ln -s {shlex.quote(self.workspace_container_dir)} {WORKSPACE_LINK} && "
                f"{keepalive}"
            )
        else:
            command = keepalive
        if initialization:
            command = f"{initialization} && {command}"
        if self.wireguard_enabled():
            config_command = ""
            if self.wireguard_config_str:
                config_command = (
                    f"install -d -m 700 {posixpath.dirname(WIREGUARD_CONFIG_CONTAINER_PATH)} && "
                    f"printf '%s' \"$DEVBOX_WIREGUARD_CONFIG_STR\" > {WIREGUARD_CONFIG_CONTAINER_PATH} && "
                    f"chmod 600 {WIREGUARD_CONFIG_CONTAINER_PATH} && "
                )
            return (
                f"{config_command}{self.wireguard_host_route_command()} && "
                f"wg-quick up {WIREGUARD_CONFIG_CONTAINER_PATH} && "
                f"ip link set dev devbox mtu {self.wireguard_mtu} && {command}"
            )
        return command

    def run_new_container(self):
        workspace_args = []
        if self.mode == "workspace":
            workspace_args = [
                "-v",
                f"{self.workspace_mount_dir}:{self.workspace_container_mount_dir}",
            ]
        self.run_cli(
            [
                "run",
                "-d",
                "--name",
                self.container_name,
                "--label",
                CONTAINER_LABEL,
                "--label",
                f"{HOME_VOLUME_LABEL}={self.home_volume}",
                "--label",
                f"{MOUNTS_LABEL}={self.mount_label()}",
                "--label",
                f"{NESTED_SANDBOX_LABEL}={str(self.nested_sandbox).lower()}",
                "--label",
                f"{EXTRA_ARGS_LABEL}={self.extra_args_label()}",
                "--label",
                f"{CONTAINER_SOCKET_LABEL}={self.container_socket}",
                "--label",
                f"{MODE_LABEL}={self.mode}",
                "--label",
                f"{WORKSPACE_LABEL}={self.workspace_dir}",
                "--label",
                f"{SSH_PORT_LABEL}={self.ssh_port}",
                "--user",
                ROOT_USER,
                *workspace_args,
                "-v",
                f"{self.home_volume}:/home/dev",
                *self.container_env_args,
                *self.custom_mount_args(),
                *self.container_socket_args(),
                *self.agent_port_args(),
                *self.ssh_port_args(),
                *self.nested_sandbox_args(),
                *self.wireguard_args(),
                *self.extra_args,
                "-w",
                self.effective_workdir(),
                IMAGE,
                "/bin/sh",
                "-lc",
                self.workspace_link_command(),
            ],
            stdout=subprocess.DEVNULL,
            check=True,
        )

    def print_start_summary(self):
        print(f"Container: {self.container_name}")
        print(f"Mode:      {self.mode}")
        if self.mode == "workspace":
            print(f"Workspace: {self.workspace_mount_dir} -> {self.workspace_container_mount_dir}")
            print(f"Symlink:   {WORKSPACE_LINK} -> {self.workspace_container_dir}")
        print(f"Workdir:   {self.effective_workdir()}")
        print(f"Home:      {self.home_volume} -> /home/dev")
        for volume in self.named_volumes:
            mode = volume.options or "rw"
            print(f"Volume:    {volume.source} -> {volume.target} ({mode})")
        if self.container_socket:
            print(f"Engine:    {self.container_socket} -> /var/run/docker.sock")
        if self.ssh_port:
            print(f"SSH:       dev@localhost:{self.ssh_port}")
        print(
            "Shell:     "
            f"{shlex.quote(self.container_cli)} exec -it {shlex.quote(self.container_name)} bash"
        )

    def exec_container(self, args):
        workdir = self.execution_dir or self.effective_workdir()
        command = [
            self.container_cli,
            "exec",
            "-it",
            "-u",
            CONTAINER_USER,
            "-w",
            workdir,
            "-e",
            f"TERM={os.environ.get('TERM') or 'xterm-256color'}",
            *self.container_env_args,
            self.container_name,
            "/usr/local/bin/devbox-entrypoint",
            *args,
        ]
        if os.name == "nt":
            result = subprocess.run(command, check=False)
            raise SystemExit(result.returncode)
        os.execvp(self.container_cli, command)

    def stop_container(self):
        container = self.container_inspect()
        if not container:
            print(f"Container does not exist: {self.container_name}")
            return
        if not self.container_running_state(container):
            print(f"Container is not running: {self.container_name}")
            return
        self.run_cli(
            ["stop", self.container_name],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        print(f"Stopped: {self.container_name}")

    def shell_container(self):
        self.assert_container_running()
        self.execution_dir = self.container_directory(self.execution_dir or os.curdir)
        self.exec_container(["bash"])

    def exec_command(self):
        self.assert_container_running()
        self.execution_dir = self.container_directory(self.execution_dir or os.curdir)
        self.exec_container(self.command_args)

    def compose_file(self):
        self.compose_service()
        self.compose_volumes()

    def compose_service(self):
        print("services:")
        print("  devbox:")
        print(f'    image: "${{DEVBOX_IMAGE:-{DEFAULT_IMAGE}}}"')
        print(f"    container_name: {yaml_quote(self.container_name)}")
        print(f"    user: {yaml_quote(ROOT_USER)}")
        print(f"    working_dir: {yaml_quote(self.effective_workdir())}")
        print("    command:")
        print("      - /bin/sh")
        print("      - -lc")
        print(f"      - {yaml_quote(self.workspace_link_command())}")

        if self.agent_port or self.ssh_port:
            print("    ports:")
            if self.agent_port:
                print('      - "${DEVBOX_AGENT_PORT}:10012"')
            if self.ssh_port:
                print(f"      - {yaml_quote(f'127.0.0.1:{self.ssh_port}:22')}")

        capabilities = []
        if self.nested_sandbox:
            capabilities.extend(("SYS_ADMIN", "SYS_CHROOT", "SETUID", "SETGID", "SYS_PTRACE"))
        if self.wireguard_enabled():
            capabilities.append("NET_ADMIN")
        if capabilities:
            print("    cap_add:")
            for capability in capabilities:
                print(f"      - {capability}")

        security_options = []
        if self.nested_sandbox:
            security_options.extend(("seccomp=unconfined", "apparmor=unconfined"))
        if self.container_socket and self.uses_podman():
            security_options.append("label=disable")
        if security_options:
            print("    security_opt:")
            for option in security_options:
                print(f"      - {option}")

        if self.container_socket_gid is not None:
            print("    group_add:")
            print(f"      - {yaml_quote(str(self.container_socket_gid))}")

        if self.wireguard_enabled():
            print("    sysctls:")
            print("      net.ipv4.conf.all.src_valid_mark: \"1\"")
            print("    extra_hosts:")
            print('      - "host.docker.internal:host-gateway"')

        print("    labels:")
        print('      org.alexn.devbox: "true"')
        print(f"      {HOME_VOLUME_LABEL}: {yaml_quote(self.home_volume)}")
        print(f"      {MOUNTS_LABEL}: {yaml_quote(self.mount_label())}")
        print(f"      {NESTED_SANDBOX_LABEL}: {yaml_quote(str(self.nested_sandbox).lower())}")
        print(f"      {EXTRA_ARGS_LABEL}: {yaml_quote(self.extra_args_label())}")
        print(f"      {CONTAINER_SOCKET_LABEL}: {yaml_quote(self.container_socket)}")
        print(f"      {MODE_LABEL}: {yaml_quote(self.mode)}")
        print(f"      {WORKSPACE_LABEL}: {yaml_quote(self.workspace_dir)}")
        print(f"      {SSH_PORT_LABEL}: {yaml_quote(self.ssh_port)}")

        self.compose_environment()
        self.compose_mounts()

    def compose_environment(self):
        environment = configured_container_envs()
        if not (environment or self.wireguard_enabled() or self.container_socket):
            return

        print("    environment:")

        for source, target, _ in environment:
            print(f'      {target}: "${{{source}}}"')

        if self.wireguard_enabled():
            print(f"      DEVBOX_WIREGUARD_MTU: {yaml_quote(self.wireguard_mtu)}")
            if self.wireguard_config_str:
                print('      DEVBOX_WIREGUARD_CONFIG_STR: "${DEVBOX_WIREGUARD_CONFIG_STR}"')

        if self.container_socket:
            print('      DOCKER_HOST: "unix:///var/run/docker.sock"')
            print('      TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE: "/var/run/docker.sock"')
            if self.rootless_podman_socket:
                print('      TESTCONTAINERS_RYUK_DISABLED: "true"')

    def compose_mounts(self):
        print("    volumes:")
        if self.mode == "workspace":
            print("      - type: bind")
            print(f"        source: {yaml_quote(self.workspace_mount_dir)}")
            print(f"        target: {yaml_quote(self.workspace_container_mount_dir)}")
        print("      - type: volume")
        print("        source: home")
        print("        target: /home/dev")

        for mount in self.mounts:
            if mount.options not in {"", "ro", "rw"}:
                raise SystemExit(
                    f"Mount options cannot be represented in Compose: {mount.original}"
                )
            print("      - type: bind")
            print(f"        source: {yaml_quote(mount.source)}")
            print(f"        target: {yaml_quote(mount.target)}")
            if mount.options == "ro":
                print("        read_only: true")

        for volume in self.named_volumes:
            print("      - type: volume")
            print(f"        source: {yaml_quote(self.compose_volume_key(volume.source))}")
            print(f"        target: {yaml_quote(volume.target)}")
            if volume.options == "ro":
                print("        read_only: true")

        if self.wireguard_config_host_path:
            print("      - type: bind")
            print('        source: "${DEVBOX_WIREGUARD_CONFIG_PATH}"')
            print(f"        target: {yaml_quote(WIREGUARD_CONFIG_CONTAINER_PATH)}")
            print("        read_only: true")

        if self.container_socket:
            print("      - type: bind")
            print(f"        source: {yaml_quote(self.container_socket)}")
            print('        target: "/var/run/docker.sock"')

    def compose_volumes(self):
        print()
        print("volumes:")
        print("  home:")
        print(f"    name: {yaml_quote(self.home_volume)}")
        print("    labels:")
        print('      org.alexn.devbox: "true"')
        for volume_name in sorted({volume.source for volume in self.named_volumes}):
            print(f"  {self.compose_volume_key(volume_name)}:")
            print(f"    name: {yaml_quote(volume_name)}")
            print("    external: true")

    def compose_volume_key(self, volume_name):
        digest = hashlib.sha256(volume_name.encode()).hexdigest()[:12]
        return f"custom_{digest}"

    def purge_container(self):
        if self.container_exists():
            self.run_cli(
                ["rm", "-f", self.container_name],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            print(f"Deleted container: {self.container_name}")
        else:
            print(f"Container does not exist: {self.container_name}")

    def restart_container(self):
        container = self.container_inspect()
        if not container:
            print(f"Container does not exist: {self.container_name}", file=sys.stderr)
            print(
                f"Run `{sys.argv[0]} start [--workspace HOST_DIR]` to create it.",
                file=sys.stderr,
            )
            raise SystemExit(1)

        if self.uses_wslc():
            if self.container_running_state(container):
                self.run_cli(
                    ["stop", self.container_name],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    check=True,
                )
            self.run_cli(
                ["start", self.container_name],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=True,
            )
        else:
            self.run_cli(
                ["restart", self.container_name],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=True,
            )
        print(f"Restarted: {self.container_name}")

    def collect_container_ids(self, container_ids, filter_arg):
        result = self.run_cli(
            ["ps", "-aq", "--filter", filter_arg],
            capture=True,
        )
        if result.returncode != 0:
            return
        for container_id in result.stdout.splitlines():
            ordered_add(container_ids, container_id)

    def list_volume_names(self):
        result = self.run_cli(["volume", "ls", "-q"], capture=True)
        if result.returncode == 0:
            return [str(line) for line in result.stdout.splitlines() if line]

        result = self.run_cli(["volume", "list", "-q"], capture=True)
        if result.returncode == 0:
            return [str(line) for line in result.stdout.splitlines() if line]

        return []

    def collect_devbox_volume_names(self, volume_names):
        for volume_name in self.list_volume_names():
            if volume_name == HOME_VOLUME_NAME or volume_name.startswith(LEGACY_HOME_VOLUME_PREFIX):
                ordered_add(volume_names, volume_name)

        if self.uses_wslc():
            return

        result = self.run_cli(["volume", "ls", "-q", "--filter", f"label={CONTAINER_LABEL}"], capture=True)
        if result.returncode != 0:
            return
        for volume_name in result.stdout.splitlines():
            ordered_add(volume_names, volume_name)

    def collect_container_home_volumes(self, volume_names, container_id):
        container = self.inspect_object(container_id)
        for mount in container.get("Mounts", []):
            name = mount.get("Name", "")
            if mount.get("Destination") == "/home/dev" and (
                name == HOME_VOLUME_NAME or name.startswith(LEGACY_HOME_VOLUME_PREFIX)
            ):
                ordered_add(volume_names, name)

    def purge_volume(self, volume_name):
        if self.run_cli(
            ["volume", "inspect", volume_name],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        ).returncode != 0:
            print(f"Volume does not exist: {volume_name}")
            return

        if self.run_cli(
            ["volume", "rm", "-f", volume_name],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        ).returncode == 0:
            print(f"Deleted volume: {volume_name}")
        else:
            print(f"Failed to delete volume: {volume_name}", file=sys.stderr)

    def purge_volumes(self, volume_names):
        if not volume_names:
            print("No devbox volumes found.")
            return

        for volume_name in volume_names:
            self.purge_volume(volume_name)

    def purge_all(self):
        container_ids = []
        volume_names = []

        self.collect_container_ids(container_ids, f"ancestor={IMAGE}")
        self.collect_container_ids(container_ids, f"label={CONTAINER_LABEL}")

        for container_id in container_ids:
            self.collect_container_home_volumes(volume_names, container_id)

        self.collect_devbox_volume_names(volume_names)

        if container_ids:
            self.run_cli(
                ["rm", "-f", *container_ids],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            print(f"Deleted devbox containers: {len(container_ids)}")
        else:
            print("No devbox containers found.")

        self.purge_volumes(volume_names)

    def update_image(self):
        self.run_cli(["pull", IMAGE], check=True)


ENVIRONMENT_HELP = f"""
Environment:
  CONTAINER_CLI                     Container CLI to use. Defaults to first available wslc.exe, wslc, docker, or podman.
  DEVBOX_IMAGE                      Image to run. Defaults to {IMAGE}.
  DEVBOX_AGENT_PORT                 Host port for container port 10012; `start` defaults to {DEFAULT_AGENT_PORT}.
  DEVBOX_HOME_VOLUME                Shared /home/dev volume name. Defaults to {HOME_VOLUME_NAME}.
  DEVBOX_HOME_VOLUME_PREFIX         Legacy per-workspace /home/dev volume prefix removed by purge-all. Defaults to {LEGACY_HOME_VOLUME_PREFIX}.
  DEVBOX_CONTAINER_SOCKET           Host engine socket used by --container-socket when auto-detection is enabled.
  DEVBOX_WIREGUARD_CONFIG_PATH      Optional path to a WireGuard configuration file. Mutually exclusive with DEVBOX_WIREGUARD_CONFIG_STR.
  DEVBOX_WIREGUARD_CONFIG_STR       Optional WireGuard configuration string written to a file inside the container. Mutually exclusive with DEVBOX_WIREGUARD_CONFIG_PATH.
  DEVBOX_WIREGUARD_MTU              Tunnel MTU used when WireGuard is enabled. Defaults to 1420; lower it if large transfers stall. Valid range: 576-9000.

Environment forwarding:
  Every valid DEVBOX_* variable not listed above is forwarded after removing DEVBOX_.
  Empty values are forwarded. DEVBOX_NAME becomes NAME. DEVBOX_AUTH_* has no special handling.
"""


def build_parser():
    parser = argparse.ArgumentParser(
        prog=os.path.basename(sys.argv[0]),
        description="Manage the JVM build-tool devbox.",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    def add_workspace_command(name, help_text):
        command_parser = subparsers.add_parser(
            name,
            help=help_text,
            description=help_text,
            formatter_class=argparse.RawDescriptionHelpFormatter,
            epilog="""Container engine access:
  --container-socket mounts the selected Docker or Podman API socket at
  /var/run/docker.sock and configures Testcontainers. This grants the devbox
  root-equivalent control of the engine, so it is disabled by default.

  Omit HOST_PATH to auto-detect the socket. Rootless Podman disables Ryuk as
  required by Testcontainers. wslc does not expose its engine API socket and
  cannot support this option.

Remote IDE access:
  --ssh-port starts key-only OpenSSH and binds it to 127.0.0.1 on the host.
  Add the client's public key to /home/dev/.ssh/authorized_keys before connecting.
  IntelliJ IDEA can then connect through Remote Development over SSH.""",
        )
        command_parser.add_argument(
            "--workspace",
            dest="workspace",
            default="",
            metavar="HOST_DIR",
            help="Use a canonical host directory as the workspace. Omit for container-native mode.",
        )
        command_parser.add_argument(
            "--mount",
            dest="mounts",
            action="append",
            default=[],
            metavar="HOST:CONTAINER[:OPTIONS]",
            help="Bind-mount an existing host file or directory. Repeatable; ~ is not expanded.",
        )
        command_parser.add_argument(
            "--container-socket",
            nargs="?",
            const="auto",
            default="",
            metavar="HOST_PATH",
            help="Expose the Docker-compatible engine socket. Auto-detects Docker or Podman when HOST_PATH is omitted; not supported by wslc.",
        )
        command_parser.add_argument(
            "--nested-sandbox",
            action="store_true",
            help="Allow Bubblewrap's nested sandbox. Supported by Docker and Podman, not wslc.",
        )
        command_parser.add_argument(
            "--ssh-port",
            metavar="HOST_PORT",
            type=tcp_port,
            help="Publish SSH on 127.0.0.1:HOST_PORT for remote IDE connections.",
        )
        command_parser.add_argument(
            "--extra-args",
            action="append",
            default=[],
            metavar="ARG",
            help="Extra container run argument. Repeatable; passed to `docker run`/`podman run` as-is.",
        )
        command_parser.add_argument(
            "--volume",
            dest="volumes",
            action="append",
            default=[],
            metavar="NAME:CONTAINER[:OPTIONS]",
            help="Mount a named volume. Repeatable; options are ro or rw.",
        )
        return command_parser

    def add_simple_command(name, help_text):
        return subparsers.add_parser(name, help=help_text, description=help_text)

    exec_parser = subparsers.add_parser(
        "exec",
        add_help=False,
        help="Run a command in the running devbox.",
        description="Run a command in the running devbox.",
    )
    exec_parser.add_argument(
        "--workdir",
        dest="execution_dir",
        default=os.curdir,
        metavar="DIRECTORY",
        help="Directory for the command. Host path in workspace mode, container path otherwise.",
    )
    exec_parser.add_argument("command_args", nargs=argparse.REMAINDER)

    add_workspace_command("start", "Start the devbox.")
    add_workspace_command("compose", "Print a docker-compose.yaml for the devbox to stdout.")

    add_simple_command("stop", "Stop the devbox.")
    add_simple_command("status", "Show devbox container and runtime status.")
    add_simple_command("restart", "Restart the devbox; fails if it does not exist.")
    shell_parser = add_simple_command(
        "shell",
        "Open an interactive shell in the running devbox at a selected directory.",
    )
    shell_parser.add_argument(
        "directory",
        nargs="?",
        default=os.curdir,
        help="Directory to open. A host path in workspace mode, or a container path in native mode.",
    )
    add_simple_command("purge", "Delete the devbox. The shared /home/dev volume is kept.")

    subparsers.add_parser(
        "purge-all",
        help="Delete all devbox containers and shared/legacy /home/dev volumes. The image is not deleted.",
        description="Delete all devbox containers and shared/legacy /home/dev volumes. The image is not deleted.",
    )

    subparsers.add_parser(
        "update",
        help="Pull the devbox image.",
        description="Pull the configured devbox image using the selected container CLI.",
    )

    subparsers.add_parser(
        "help-env",
        help="Show list of supported environment variables.",
        description="Show list of supported environment variables and DEVBOX_* forwarding behavior.",
    )

    return parser


def create_devbox(namespace, container_cli):
    workspace_dir = ""
    if hasattr(namespace, "workspace") and namespace.workspace:
        workspace_dir = workspace_path(namespace.workspace)

    command_args = getattr(namespace, "command_args", [])
    execution_dir = getattr(namespace, "execution_dir", os.curdir)
    if namespace.command == "shell":
        execution_dir = namespace.directory
    elif namespace.command == "exec":
        command_args = list(command_args)
        if command_args and command_args[0] == "--":
            command_args.pop(0)

    devbox = DevBox(namespace.command, workspace_dir, command_args, container_cli, execution_dir)
    devbox.mounts = parse_mounts(getattr(namespace, "mounts", []))
    devbox.named_volumes = parse_named_volumes(getattr(namespace, "volumes", []), devbox.mounts)
    devbox.nested_sandbox = getattr(namespace, "nested_sandbox", False)
    devbox.extra_args = list(getattr(namespace, "extra_args", []))
    devbox.container_socket_request = getattr(namespace, "container_socket", "")
    devbox.ssh_port = getattr(namespace, "ssh_port", None) or ""
    return devbox


def dispatch(devbox):
    if devbox.command == "restart":
        devbox.restart_container()
        return

    handlers = {
        "start": devbox.start_container,
        "stop": devbox.stop_container,
        "status": devbox.status_container,
        "shell": devbox.shell_container,
        "exec": devbox.exec_command,
        "compose": devbox.compose_file,
        "purge": devbox.purge_container,
        "purge-all": devbox.purge_all,
        "update": devbox.update_image,
    }

    try:
        handler = handlers[devbox.command]
    except KeyError as error:
        raise ValueError(f"Unhandled command: {devbox.command}") from error

    handler()


def main(argv=None):
    parser = build_parser()
    namespace = parser.parse_args(argv)

    if namespace.command == "help-env":
        print(ENVIRONMENT_HELP.strip())
        return 0

    if namespace.command == "exec":
        command_args = namespace.command_args[1:] if namespace.command_args[:1] == ["--"] else namespace.command_args
        if not command_args or not command_args[0]:
            parser.error("exec requires <command> [argument ...]")

    container_cli = os.environ.get("CONTAINER_CLI", "docker") if namespace.command == "compose" else None
    if namespace.command != "compose":
        container_cli = find_container_cli()
        if not container_cli:
            print(
                "No container CLI found. Install wslc.exe, docker, or podman, or set CONTAINER_CLI.",
                file=sys.stderr,
            )
            return 1

    devbox = create_devbox(namespace, container_cli)

    if namespace.command in {"start", "restart", "shell", "exec", "compose"}:
        devbox.configure_wireguard()
        devbox.configure_nested_sandbox()
        devbox.configure_container_socket()

    devbox.configure_agent_port()
    devbox.configure_container_env_args()
    dispatch(devbox)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
